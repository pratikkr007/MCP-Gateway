@app.post("/admin/users", status_code=201)
async def admin_create_user(payload: UserCreate):
    try:
        user_id = create_user(
            payload.username,
            payload.role,
            payload.email,
        )
    except Exception as exc:
        if "UNIQUE constraint failed" in str(exc):
            raise HTTPException(
                status_code=409,
                detail="Username or email already exists",
            ) from exc

        if isinstance(exc, ValueError):
            raise HTTPException(
                status_code=400,
                detail=str(exc),
            ) from exc

        raise

    return {
        "user_id": user_id,
        "username": payload.username,
        "role": payload.role,
    }


@app.post("/admin/users/{user_id}/keys", status_code=201)
async def admin_issue_key(user_id: str, payload: KeyCreate):
    try:
        return issue_api_key(user_id, payload.label)
    except ValueError as exc:
        raise HTTPException(
            status_code=404,
            detail=str(exc),
        ) from exc


@app.get("/admin/keys")
async def admin_list_keys():
    with connect_db() as conn:
        rows = conn.execute(
            """
            SELECT
                k.id AS key_id,
                k.user_id,
                u.username,
                k.label,
                k.created_at,
                k.revoked_at,
                k.revoked
            FROM api_keys AS k
            JOIN users AS u ON u.id = k.user_id
            ORDER BY k.id DESC
            LIMIT 500
            """
        ).fetchall()

    return {"keys": [dict(row) for row in rows]}


@app.post("/admin/keys/{key_id}/revoke")
