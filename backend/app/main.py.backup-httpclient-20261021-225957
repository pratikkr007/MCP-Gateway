@app.post("/admin/upstreams", status_code=201)
async def add_upstream(payload: UpstreamCreate):
    name = safe_tool_name(payload.name)

    if len(name) < 2:
        raise HTTPException(
            status_code=400,
            detail="Upstream name must contain at least two valid characters",
        )

    if name in UPSTREAMS:
        raise HTTPException(
            status_code=409,
            detail=f"Upstream '{name}' already exists",
        )

    url = validate_upstream_url(payload.url)

    try:
        save_upstream(
            name=name,
            url=url,
            enabled=payload.enabled,
        )
    except ValueError as exc:
        raise HTTPException(
            status_code=400,
            detail=str(exc),
        ) from exc

    UPSTREAMS[name] = url
    UPSTREAM_ENABLED[name] = payload.enabled

    result = await refresh_upstream_tools()

    return {
        "message": "Upstream added",
        "name": name,
        "enabled": payload.enabled,
        **result,
    }


@app.patch("/admin/upstreams/{name}")
async def update_upstream(name: str, payload: UpstreamUpdate):
    if name not in UPSTREAMS:
        raise HTTPException(
            status_code=404,
            detail="Upstream not found",
        )

    new_url = (
        validate_upstream_url(payload.url)
        if payload.url is not None
        else UPSTREAMS[name]
    )

    new_enabled = (
        payload.enabled
        if payload.enabled is not None
        else UPSTREAM_ENABLED.get(name, False)
    )

    save_upstream(
        name=name,
        url=new_url,
        enabled=new_enabled,
    )

    UPSTREAMS[name] = new_url
    UPSTREAM_ENABLED[name] = new_enabled

    result = await refresh_upstream_tools()

    return {
        "message": "Upstream updated",
        "name": name,
        "url": UPSTREAMS[name],
        "enabled": UPSTREAM_ENABLED[name],
        **result,
    }


@app.delete("/admin/upstreams/{name}")
async def delete_upstream(name: str):
    if name not in UPSTREAMS:
        raise HTTPException(
            status_code=404,
            detail="Upstream not found",
        )

    del UPSTREAMS[name]
    UPSTREAM_ENABLED.pop(name, None)
    delete_upstream_record(name)

    async with REGISTRATION_LOCK:
        old_names = [
            tool_name
            for tool_name, route in TOOL_ROUTES.items()
            if route["server"] == name
        ]

        for tool_name in old_names:
            gateway_mcp.remove_tool(tool_name)
            TOOL_ROUTES.pop(tool_name, None)

    return {
        "message": "Upstream removed",
        "name": name,
        "removed_tools": len(old_names),
    }



class ChatRequest(BaseModel):
    message: str
    history: list[dict[str, str]] | None = None


@app.post("/api/chat")
async def chat_with_agent(payload: ChatRequest, request: Request):
    """Chat with an LLM that can invoke tools through this MCP gateway."""
    import json
    import os
    import httpx
    from mcp import ClientSession
    from mcp.client.streamable_http import streamable_http_client

    api_key = request.headers.get("x-api-key")
    llm_key = os.getenv("LLM_API_KEY") or os.getenv("OPENAI_API_KEY")
    base_url = os.getenv("LLM_BASE_URL", "https://api.openai.com/v1").rstrip("/")
    model = os.getenv("LLM_MODEL", "gpt-4o-mini")
    gateway_url = os.getenv(
        "GATEWAY_MCP_URL", "http://127.0.0.1:8081/mcp/mcp"
    )

    if not api_key:
        raise HTTPException(status_code=401, detail="Missing gateway API key.")
    if not llm_key:
        raise HTTPException(
            status_code=503,
            detail="Chat model is not configured. Set LLM_API_KEY or OPENAI_API_KEY."
        )
    if not payload.message.strip():
        raise HTTPException(status_code=422, detail="Message cannot be empty.")

    messages = [{
        "role": "system",
        "content": (
            "You are a helpful team assistant. Use the available MCP tools "
            "when needed to answer questions or perform requested actions. "
            "Never claim an action succeeded unless a tool result confirms it. "
            "Ask for clarification when required arguments are missing."
        )
    }]

    # Accept only ordinary conversation history, not client-supplied tool results.
    for item in (payload.history or [])[-12:]:
        role = item.get("role")
        content = item.get("content")
        if role in ("user", "assistant") and isinstance(content, str):
            messages.append({"role": role, "content": content})

    messages.append({"role": "user", "content": payload.message})
    executed_calls = []

    try:
        async with streamable_http_client(
            gateway_url,
            headers={"x-api-key": api_key},
        ) as (read_stream, write_stream, _):
            async with ClientSession(read_stream, write_stream) as session:
                await session.initialize()
                listed = await session.list_tools()

                llm_tools = []
                for tool in listed.tools:
                    llm_tools.append({
                        "type": "function",
                        "function": {
                            "name": tool.name,
                            "description": tool.description or tool.name,
                            "parameters": tool.inputSchema or {
                                "type": "object", "properties": {}
                            },
                        },
                    })

                async with httpx.AsyncClient(timeout=60.0) as client:
                    for _ in range(6):
                        body = {
                            "model": model,
                            "messages": messages,
                        }
                        if llm_tools:
                            body["tools"] = llm_tools
                            body["tool_choice"] = "auto"

                        response = await client.post(
                            f"{base_url}/chat/completions",
                            headers={"Authorization": f"Bearer {llm_key}"},
                            json=body,
                        )
                        response.raise_for_status()
                        choice = response.json()["choices"][0]
                        assistant_message = choice["message"]
                        calls = assistant_message.get("tool_calls") or []

                        if not calls:
                            return {
                                "answer": assistant_message.get("content") or "",
                                "tool_calls": executed_calls,
                                "model": model,
                            }

                        messages.append(assistant_message)

                        for call in calls:
                            function = call["function"]
                            tool_name = function["name"]

                            try:
                                arguments = json.loads(
                                    function.get("arguments") or "{}"
                                )
                                result = await session.call_tool(
                                    tool_name, arguments=arguments
                                )

                                content = []
                                for item in (result.content or []):
                                    text_value = getattr(item, "text", None)
                                    if text_value is not None:
                                        content.append(text_value)
                                    elif hasattr(item, "model_dump"):
                                        content.append(
                                            item.model_dump(mode="json")
                                        )
                                    else:
                                        content.append(str(item))

                                tool_output = json.dumps({
                                    "isError": bool(result.isError),
                                    "content": content,
                                }, ensure_ascii=False)

                                executed_calls.append({
                                    "tool": tool_name,
                                    "arguments": arguments,
                                    "result": tool_output[:4000],
                                    "isError": bool(result.isError),
                                })
                            except Exception as exc:
                                tool_output = json.dumps({
                                    "error": str(exc)[:1000]
                                })
                                executed_calls.append({
                                    "tool": tool_name,
                                    "error": str(exc)[:1000],
                                })

                            messages.append({
                                "role": "tool",
                                "tool_call_id": call["id"],
                                "content": tool_output,
                            })

                return {
                    "answer": "The tool-call limit was reached. Please refine your request.",
                    "tool_calls": executed_calls,
                    "model": model,
                }

    except HTTPException:
        raise
    except httpx.HTTPStatusError as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Chat provider returned HTTP {exc.response.status_code}."
        ) from exc
    except httpx.TimeoutException as exc:
        raise HTTPException(
            status_code=504,
            detail="The chat provider timed out."
        ) from exc
    except Exception as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Chat agent failed: {str(exc)[:500]}"
        ) from exc



# MCP endpoint: http://127.0.0.1:8081/mcp/mcp
app.mount(
    "/mcp",
    gateway_mcp.streamable_http_app(),
)
